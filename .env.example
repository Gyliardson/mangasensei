# Docker Compose Quick Start:
# - copy this file to .env;
# - replace POSTGRES_PASSWORD and MANGASENSEI_CAPABILITY_PEPPERS with fresh random values;
# - leave GOOGLE_API_KEY blank for local-only OCR and linguistics.
#
# MANGASENSEI_DATABASE_URL and the host-relative paths below are used by direct host
# development commands. Docker Compose overrides them with container-internal values.
# If you run the backend directly on the host, keep the database password here in sync
# with POSTGRES_PASSWORD.
#
# Generate random values with Python if it is already installed:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=replace-with-a-long-random-password
MANGASENSEI_ENVIRONMENT=development
MANGASENSEI_DATABASE_URL=postgresql+psycopg://mangasensei:replace-with-a-long-random-password@localhost:5432/mangasensei
MANGASENSEI_STORAGE_ROOT=var/storage
MANGASENSEI_MODEL_CACHE=var/models
MANGASENSEI_JMDICT_PATH=var/data/jmdict.json
MANGASENSEI_FRONTEND_DIST=frontend/dist
MANGASENSEI_CAPABILITY_PEPPERS=["replace-with-a-long-random-pepper"]
MANGASENSEI_RETENTION_HOURS=24
MANGASENSEI_MAX_UPLOAD_BYTES=12582912
MANGASENSEI_MAX_IMAGE_PIXELS=25000000
MANGASENSEI_MAX_IMAGE_SIDE=10000
# Slice B ordered image Documents are bounded independently from per-image limits.
MANGASENSEI_MAX_DOCUMENT_IMAGES=200
MANGASENSEI_MAX_DOCUMENT_BYTES=536870912
MANGASENSEI_MAX_DOCUMENT_PIXELS=1000000000
MANGASENSEI_API_RATE_LIMIT_PER_MINUTE=120
MANGASENSEI_UPLOAD_RATE_LIMIT_PER_MINUTE=10
MANGASENSEI_REPROCESS_RATE_LIMIT_PER_MINUTE=6
MANGASENSEI_WORKER_POLL_SECONDS=1.0
MANGASENSEI_WORKER_LEASE_SECONDS=300
MANGASENSEI_RETENTION_POLL_SECONDS=60
MANGASENSEI_OCR_DEVICE=cpu
MANGASENSEI_GEMINI_MODEL=gemini-3.6-flash
MANGASENSEI_GEMINI_DAILY_BUDGET_USD=5.00
MANGASENSEI_GEMINI_MAX_CALLS_PER_PAGE=3
# Gemini is optional. Leave this blank for local-only OCR and linguistics.
GOOGLE_API_KEY=
