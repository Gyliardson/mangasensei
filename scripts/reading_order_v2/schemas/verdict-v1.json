    "reasons":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["gate","arm","status","detail"],"properties":{"gate":{"type":"string"},"arm":{"type":"string"},"status":{"enum":["fail","inconclusive"]},"detail":{"type":"string"}}}}
  }
}
