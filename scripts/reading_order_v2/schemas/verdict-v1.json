{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"reading-order-v2-verdict-v1",
  "type":"object",
  "additionalProperties":false,
  "required":["verdict","harness_status","a_status","b_status","combined_status","reasons"],
  "properties":{
